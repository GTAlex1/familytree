rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: la cuenta con este UID (Authentication → Usuarios)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'XWZtyD2p7XZbDUjFhBorr2jEPDu2';
    }

    // El ID del documento ES el código de 5 letras.
    match /trees/{code} {
      // Ver un árbol: hay que conocer su código
      allow get: if code.matches('[A-Z]{5}');
      // Listar: el admin ve todos; cada editor ve los árboles donde es editor
      allow list: if isAdmin()
        || (request.auth != null && request.auth.uid in resource.data.editors);
      // Crear y borrar: solo admin
      allow create, delete: if isAdmin() && code.matches('[A-Z]{5}');
      // Modificar: admin todo; editores solo el campo "people"
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.uid in resource.data.editors
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people']));
    }

    // Datos de cada usuario: códigos guardados y nombre de usuario (perfil)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codes', 'username'])
        && (!('codes' in request.resource.data) || request.resource.data.codes.size() <= 50)
        && (!('username' in request.resource.data)
            || request.resource.data.username.matches('[a-z0-9_.-]{3,20}'));
    }

    // Nombre de usuario -> UID (para poder añadir editores por nombre)
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && name.matches('[a-z0-9_.-]{3,20}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      // Soltar el nombre propio (para cambiarlo desde Perfil)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
