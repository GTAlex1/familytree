rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: la cuenta con este UID (Authentication → Usuarios)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'XWZtyD2p7XZbDUjFhBorr2jEPDu2';
    }

    // El ID del documento ES el código de 5 letras.
    // Campo "owner" = UID del propietario (el usuario que creó el árbol).
    // Los árboles antiguos sin "owner" solo los gestiona el admin.
    match /trees/{code} {
      function isOwner() {
        return request.auth != null && 'owner' in resource.data && resource.data.owner == request.auth.uid;
      }

      // Ver un árbol: hay que conocer su código
      allow get: if code.matches('[A-Z]{5}');
      // Listar: el admin ve todos; cada usuario ve los suyos y aquellos donde es editor
      allow list: if isAdmin()
        || isOwner()
        || (request.auth != null && request.auth.uid in resource.data.editors);
      // Crear: admin, o cualquier usuario registrado siendo él el propietario
      allow create: if code.matches('[A-Z]{5}') && (isAdmin()
        || (request.auth != null
            && request.resource.data.owner == request.auth.uid
            && request.resource.data.keys().hasOnly(['name', 'people', 'editors', 'editorNames', 'owner'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 60));
      // Borrar: admin o propietario
      allow delete: if isAdmin() || isOwner();
      // Modificar: admin todo; propietario todo menos cambiar "owner";
      // editores solo el campo "people"
      allow update: if isAdmin()
        || (isOwner()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner']))
        || (request.auth != null
            && request.auth.uid in resource.data.editors
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people']));
    }

    // Datos de cada usuario: códigos guardados y nombre de usuario (perfil)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codes', 'username'])
        && (!('codes' in request.resource.data) || request.resource.data.codes.size() <= 50)
        && (!('username' in request.resource.data)
            || request.resource.data.username.matches('[a-z0-9_.-]{3,20}'));
    }

    // Nombre de usuario -> UID (para poder añadir editores por nombre)
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && name.matches('[a-z0-9_.-]{3,20}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      // Soltar el nombre propio (para cambiarlo desde Perfil)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
